#!/bin/sh
set -eu
# shellcheck disable=SC1091
. /etc/conf.d/astrlink
export ASTRLINK_CONTROL_SOCKET="${ASTRLINK_CONTROL_SOCKET:-$ASTRLINK_DATA_DIR/control.sock}"
if [ "$(id -u)" = 0 ]; then
	exec su -p -s /bin/sh -c 'exec /usr/bin/astrlink-cli "$@"' -- astrlink sh "$@"
fi
exec /usr/bin/astrlink-cli "$@"
